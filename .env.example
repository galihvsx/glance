# glance — example environment. Copy to `.env` and fill in the values:
#   cp .env.example .env
# `docker compose` reads `.env` automatically from the compose file's directory.
# Never commit a real `.env` (it's gitignored).

# --- Required ---
# Postgres connection string.
DATABASE_URL=postgres://glance:glance@localhost:5432/glance?sslmode=disable
# Server-side secret for OTP hashes. The server REFUSES to boot without it
# (fail closed). Generate with: openssl rand -base64 32
OTP_PEPPER=change-me-generate-with-openssl-rand-base64-32

# --- Optional: server ---
# HTTP listen port.
PORT=8080
# Public base URL (used for links in emails).
APP_URL=http://localhost:8080
# Deployment environment. Set to "production" in production: the
# ALLOW_INSECURE_OTP_PEPPER hatch is then IGNORED and an empty
# OTP_PEPPER hard-fails boot. Leave empty (or anything else) for dev.
APP_ENV=
# Comma-separated CIDRs of trusted reverse proxies. X-Forwarded-For is
# honored ONLY from these ranges (it feeds IP-keyed rate limits).
# Empty (default) = trust none: the direct TCP peer is the client IP,
# and spoofed X-Forwarded-For headers are ignored. Behind a local
# reverse proxy, add e.g. 127.0.0.1/32.
TRUSTED_PROXY_CIDRS=

# --- Optional: local file storage ---
# Filesystem root for glance's local data. Issue attachment bytes live
# under <GLANCE_DATA_DIR>/attachments (metadata stays in Postgres).
# Defaults to ./data (relative to the server's working directory).
GLANCE_DATA_DIR=./data
# Per-file upload cap in megabytes for issue attachments. Must be a
# positive integer; anything else refuses to boot. Defaults to 25.
GLANCE_MAX_UPLOAD_MB=25

# --- Optional: outbound mail ---
# When SMTP_HOST is unset, outbound mail falls back to logging (dev-friendly).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com

# --- Optional: OAuth login (Google / GitHub) ---
# When unset, only email-OTP login is available.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_STATE_SECRET=

# --- Dev-only escape hatch ---
# Allows booting without OTP_PEPPER. Never set in production.
# ALLOW_INSECURE_OTP_PEPPER=1
